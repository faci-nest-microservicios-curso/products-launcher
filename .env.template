CLIENT_GATEWAY_PORT=3000

PAYMENT_MS_PORT=3003

AUTH_MS_PORT=3004

JWT_SECRET=<SECRETO_JWT>

JWT_EXPIRES_IN=2h

STRIPE_SECRET=sk_test_<VALOR>
STRIPE_SUCCESS_URL=http://localhost:3000/payments/success
STRIPE_CANCEL_URL=http://localhost:3000/payments/cancel
STRIPE_ENDPOINT_SECRET=whsec_<VALOR>

# --- Producción (docker-compose.prod.yml): bases de datos externas ---
AUTH_DATABASE_URL=mongodb+srv://usuario:password@cluster.mongodb.net/AuthDB
ORDERS_DATABASE_URL=postgresql://usuario:password@host:5432/ordersdb?schema=public

# --- Registry de imágenes para producción ---
# IMAGE_REGISTRY es el prefijo de las imágenes; IMAGE_TAG la versión.
# Por defecto: localhost:5000 y 1.0.0 (ver registry/docker-compose.yml).
IMAGE_REGISTRY=localhost:5000
IMAGE_TAG=1.0.0

# OJO con orders-ms: su dockerfile.prod ejecuta `prisma migrate deploy` en
# tiempo de build, así que ORDERS_DATABASE_URL debe ser alcanzable desde el
# build. En local puedes usar:
#   ORDERS_DATABASE_URL=postgresql://postgres:123456@host.docker.internal:5433/ordersdb?schema=public